# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-nano

# Telegram bot (leave blank to disable notifications)
TG_TOKEN=1234567890:AABBCCDD...
TG_CHAT_ID=-100123456789

# Google Sheets spreadsheet ID (from the URL)
SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Scoring threshold: notify when score >= this value
SCORE_NOTIFY_THRESHOLD=8

# AutoScout24 page request throttle (seconds, uniform random between min and max)
AS24_THROTTLE_MIN=2.0
AS24_THROTTLE_MAX=6.0

# Integration test settings (set to 1 only when running tests_integration/)
INTEGRATION_TESTS=0
INTEGRATION_SHEET_ID=

# File paths (relative to project root)
BRIEF_PATH=brief.md
CREDS_PATH=creds.json
