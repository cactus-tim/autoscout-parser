# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Telegram bot (leave blank to disable notifications).
# For groups, the chat_id is negative (e.g. -1001234567890 for supergroups,
# -123456789 for legacy groups). The bot must be a member of the group.
TG_TOKEN=1234567890:AABBCCDD...
TG_CHAT_ID=-100123456789

# Google Sheets spreadsheet ID (from the URL)
SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Scoring threshold: notify when score >= this value
SCORE_NOTIFY_THRESHOLD=7

# AutoScout24 page request throttle (seconds, uniform random between min and max)
AS24_THROTTLE_MIN=2.0
AS24_THROTTLE_MAX=6.0

# Enrich listings with detail-page data (equipment, colours). Default true.
# Set to false to skip enrichment and score on model_text only.
AS24_ENRICH=true

# Scheduler (used by --schedule mode / Docker entrypoint).
# UTC crontab. Default: 03:15 UTC daily.
SCHEDULE_CRON=15 3 * * *
# Set RUN_ON_STARTUP=true to fire one immediate run when the container starts
# (useful on first deploy / smoke test). Otherwise scheduler waits for the cron.
RUN_ON_STARTUP=false

# Integration test settings (set to 1 only when running tests_integration/)
INTEGRATION_TESTS=0
INTEGRATION_SHEET_ID=

# File paths.
# When running directly with `uv run` on the host, these stay relative to the
# project root. When running via docker-compose, the compose file overrides
# both to /app/{creds.json,brief.md} so this section can be ignored.
BRIEF_PATH=brief.md
CREDS_PATH=creds.json
