{
  "_comment": "EXAMPLE FILE. Download a real service-account JSON from GCP Console and replace this entire file with it. The structure shown here is what your real file will look like.",
  "type": "service_account",
  "project_id": "<your-gcp-project-id>",
  "private_key_id": "<40-char-hex-id>",
  "private_key": "<paste-RSA-private-key-here>",
  "client_email": "<sa-name>@<your-gcp-project-id>.iam.gserviceaccount.com",
  "client_id": "<numeric-id>",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/<sa-name>%40<your-gcp-project-id>.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}
